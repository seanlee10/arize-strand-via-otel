ANTHROPIC_API_KEY=
# Client credential: forwarded as the authorization OTLP request header.
ARIZE_API_KEY=
# Client routing: forwarded as the arize-space-id OTLP request header.
ARIZE_SPACE_ID=
ARIZE_PROJECT_NAME=strands-agent-sample
# Collector -> Arize (US)
ARIZE_COLLECTOR_ENDPOINT=https://otlp.arize.com/v1/traces
# Python client -> local Collector (OTLP HTTP/Protobuf)
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://127.0.0.1:4318/v1/traces
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
